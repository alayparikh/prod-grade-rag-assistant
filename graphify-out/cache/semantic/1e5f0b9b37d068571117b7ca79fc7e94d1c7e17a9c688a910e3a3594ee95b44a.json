{"nodes": [{"id": "claude_agent_instructions", "label": "CLAUDE.md Agent Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_knowledge_graph_first", "label": "Use the knowledge graph before reading code", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The graphify graph in graphify-out/ is used instead of reading the whole codebase; open only the source files the graph points to. Gitignored files are not in the graph and must be read directly."}, {"id": "claude_production_scale_rules", "label": "Build for production scale rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system is treated as production holding terabytes of documents and millions of orders with many concurrent users; the current setup is sized for the demo corpus but code must not assume data stays small."}, {"id": "claude_never_load_whole_corpus", "label": "Never load a whole corpus into memory (stream, paginate, batch)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_incremental_idempotent_indexing", "label": "Incremental and idempotent indexing", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-index only changed files (content hash / mtime), make every job safe to retry, and design it to run as per-file jobs on a queue."}, {"id": "claude_backends_behind_interfaces", "label": "Keep backends behind interfaces", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector store, keyword index, cache, rate limiter, database and LLM are each accessed through one module so swapping Chroma for pgvector is a config change, not a rewrite."}, {"id": "claude_bound_everything", "label": "Bound everything (row limits, timeouts, token budgets, step caps)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_stateless_app_processes", "label": "Stateless app processes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No per-process state that must be shared across instances (cache, rate limits, sessions); put it behind an interface that can move to Redis."}, {"id": "claude_security_outside_model", "label": "Security is enforced outside the model", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access filtering, the SQL guard, role views and read-only connections stay in code and the database, never in the prompt. The model never supplies user identity."}, {"id": "claude_measure_it", "label": "Measure it (timings, tokens, cost, tests, eval cases)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_scale_path_table", "label": "Current choice vs. scale target table", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick the simplest tool that works now and note the scale path: what replaces it and when."}, {"id": "claude_vector_store_scale_path", "label": "Vector store: Chroma now, pgvector/Qdrant at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch when >1M chunks, multiple app instances, or filtered search at scale."}, {"id": "claude_keyword_search_scale_path", "label": "Keyword search: in-process BM25 now, OpenSearch/Postgres full-text at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch when the index no longer fits in memory."}, {"id": "claude_cache_rate_limit_scale_path", "label": "Answer cache and rate limit: in-process now, Redis at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch when there is more than one app instance."}, {"id": "claude_orders_db_scale_path", "label": "Orders DB: SQLite read-only role views now, Postgres read replica with RLS at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_indexer_scale_path", "label": "Indexer: single process now, per-file queue jobs at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agent_scale_path", "label": "Agent: opt-in bounded tool loop now, router plus shared answer cache at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch when users pick the wrong mode or agent traffic makes repeat questions costly; answers then cached per user + index version + orders snapshot."}, {"id": "claude_demo_agent_answers_scale_path", "label": "Demo agent answers: saved runs plus fixed-step live runs now, hosted agent endpoint at scale", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Section 2 table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch when visitors need questions planned beyond the fixed steps; target is a hosted agent endpoint with server-side key, spend cap and rate limit."}, {"id": "claude_docs_ui_sync_checklist", "label": "Keep docs and UI in sync checklist", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any change affecting architecture, behaviour, data flow, configuration or measured numbers must update README, INTERVIEW_NOTES, demo README and UI, DEPLOY, eval fixtures, the scale table and the knowledge graph in the same change. Numbers must come from a real run, not estimates."}, {"id": "claude_verify_before_done", "label": "Verify before calling it done", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pytest passes, retrieval eval passes (live eval for prompt or generation changes), and demo changes build the index and run demo/check_search.mjs."}], "edges": [{"source": "claude_agent_instructions", "target": "claude_knowledge_graph_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Section 1", "weight": 1.0}, {"source": "claude_agent_instructions", "target": "claude_production_scale_rules", "relation": "references", "confidence": "EXTRACTED", "confidence