# Copy to .env and fill in. .env is git-ignored and is read by
# docker compose at start; never commit it.

# --- required for generated answers ---------------------------------
# Without a key the app runs in offline mode: answers are the best-matching
# passages, and no API call is ever made. RAG_LLM=off forces offline mode
# even when a key is set - use it on any publicly reachable instance.
ANTHROPIC_API_KEY=sk-ant-...
#RAG_LLM=auto

# Synology hostname or IP, and the top-level shared folder to search.
# The share name is what appears under Control Panel > Shared Folder,
# e.g. \\nas.local\company  ->  RAG_NAS_SHARE=company
RAG_NAS_HOST=nas.local
RAG_NAS_SHARE=company

# --- usually left alone ----------------------------------------------
# Read-only mount of that share, inside the container.
RAG_DOCS_PATH=/mnt/nas

# "nas" requires every user to sign in with their Synology account.
# "none" disables login AND the per-file access check - local testing only.
RAG_AUTH_MODE=nas

# Minutes of inactivity before a signed-in session expires.
RAG_SESSION_IDLE_MIN=30

# Nightly index time, 24h, in the container's own timezone - which is UTC
# unless TZ is set, so set both together or the run lands hours off.
RAG_INDEX_AT=02:00
TZ=America/Los_Angeles

# --- tuning -----------------------------------------------------------
# Set after the first census. bge-small is a better English model than
# the MiniLM default; use BAAI/bge-m3 if the share holds Hindi or
# Gujarati documents. Changing this needs a full --reindex.
#RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OCR languages, '+'-separated Tesseract codes. Add packages to the
# Dockerfile before adding codes here (eng is installed by default).
#RAG_OCR_LANGS=eng
#RAG_OCR=0
#RAG_OCR_MAX_PAGES=50

# Extra folders to skip, comma-separated globs.
#RAG_EXCLUDE_GLOBS=Archive 2019,*_backup

# Rows kept per spreadsheet sheet before truncating.
#RAG_XLSX_MAX_ROWS=2000

# --- stage-1 ACL pre-filter (leave off until verified on the NAS) -----
# Requires that the Synology answers a security-descriptor query AND that
# group membership resolves. The per-file check at query time is correct
# without this; the pre-filter only makes it faster.
#RAG_ACL_TAGGING=1
#RAG_LDAP_URL=ldap://dc.company.local
#RAG_LDAP_BASE_DN=dc=company,dc=local

# --- query pipeline ---------------------------------------------------
# Cross-encoder reranker: retrieval stays wide, only the top N reach Claude.
# Use BAAI/bge-reranker-v2-m3 for Hindi/Gujarati (rebuild the image).
#RAG_RERANK=0
#RAG_RERANK_TOP_N=10
#RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Haiku relevance grading + one rewrite-and-retry when nothing is relevant.
#RAG_GRADE=0
#RAG_GRADER_MODEL=claude-haiku-4-5

# Per-user answer cache (first-turn questions only), invalidated by any reindex.
#RAG_CACHE=0
#RAG_CACHE_TTL_HOURS=24

# Index health: the indexer container goes unhealthy past this age.
#RAG_INDEX_MAX_AGE_HOURS=36

# Langfuse tracing. Traces contain document text: SELF-HOSTED ONLY. The app
# refuses to enable tracing without LANGFUSE_HOST. Needs `pip install langfuse`.
#RAG_TRACING=langfuse
#LANGFUSE_HOST=http://langfuse.local:3000
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...

# --- order questions ("Ask about orders") -------------------------------
# SQLite file the order mode reads, opened read-only. Built from
# eval/fixtures/orders.sql if missing; point it at a read-only copy of the
# real orders database in a deployment.
#RAG_ORDERS_DB=/data/orders.db
# Role for local testing (admin, engineer, contractor, none).
#RAG_ORDER_ROLE=admin
# NAS mode: group SID -> order role, first match wins. Users in none of
# them, or whose groups can't be resolved, get no order access.
#RAG_ORDER_GROUP_ROLES=S-1-5-21-...-512=admin,S-1-5-21-...-1104=contractor
