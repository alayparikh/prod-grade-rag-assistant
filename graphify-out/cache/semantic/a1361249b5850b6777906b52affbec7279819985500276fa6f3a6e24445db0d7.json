ery_pipeline", "target": "readme_answer_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_query_pipeline", "target": "readme_nas_access_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_query_pipeline", "target": "readme_offline_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_prompt_injection_resistance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_nas_access_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_empty_context_short_circuit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_secret_redaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_source_attribution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_guardrails", "target": "readme_relevance_grading", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": 