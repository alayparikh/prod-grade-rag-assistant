{"nodes": [{"id": "readme_rag_assistant", "label": "RAG Assistant README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ingest_pipeline", "label": "Ingest pipeline (local, no API calls)", "file_type": "concept", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "discover_files, file_hash + CHUNKER_VERSION vs manifest.json to skip unchanged files, load_file, split_documents at headings then 1000-char windows prefixed with section path, ACL group tags, local MiniLM embeddings into Chroma + SQLite FTS5, heartbeat written to indexer_status.json."}, {"id": "readme_query_pipeline", "label": "Query pipeline (only Claude usage)", "file_type": "concept", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_single_entry_point", "label": "answer_question() as single guardrail entry point", "file_type": "rationale", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "answer_question() is the single entry point for both the CLI and web UI, so guardrails apply everywhere by construction."}, {"id": "readme_hybrid_retrieval", "label": "Hybrid retrieval: vector + BM25 fused with RRF (EnsembleRetriever)", "file_type": "concept", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BM25 uses a custom regex tokenizer because the default splits on whitespace, making a whole URL one unmatchable token."}, {"id": "readme_adaptive_retrieval_breadth", "label": "Adaptive retrieval breadth (compute_k)", "file_type": "rationale", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k is derived from corpus size (about +1 per 100 chunks, clamped 4-20, override RAG_RETRIEVAL_K). A fixed k=4 was fine at 54 chunks but silently starved recall at 1,038 chunks. Wider retrieval raised cost (~$0.011 to ~$0.020) until the reranker and Haiku grading trimmed what reaches Sonnet (about $0.0055 per answered question on the fixture golden set)."}, {"id": "readme_cross_encoder_rerank", "label": "Cross-encoder rerank to top 10 (local)", "file_type": "concept", "source_file": "README.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_relevance_grading", "label": "Haiku relevance grading (fails open, rewrite and retry once)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A grading error keeps every chunk: grading trims cost and noise, it never authorizes."}, {"id": "readme_answer_cache", "label": "Answer cache (per user + question + index version, first turn only)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hit re-runs the access check on every source file, so revoked permissions turn it into a miss."}, {"id": "readme_guardrails", "label": "Guardrails enforced inside answer_question()", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prompt_injection_resistance", "label": "Prompt-injection resistance (retrieved_context tags as untrusted data)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nas_access_check", "label": "Per-file NAS access check (query-time, as the asking user)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every retrieved chunk's file is opened over SMB as the asking user before generation; revoking NAS access takes effect on the next question with no reindex."}, {"id": "readme_two_stage_authorization", "label": "Two-stage authorization (index-time tags + query-time check)", "file_type": "rationale", "source_file": "README.md", "source_location": "Authorization comes from the NAS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index-time group tags are a cheap pre-filter but a stale snapshot; the query-time SMB open is authoritative. There is no user table or group file; login opens a real SMB session. Retrieval over-fetches (RAG_OVER_FETCH 3x) so filtering leaves enough context. A fully-filtered result uses the same wording as an empty one so a refusal never reveals a document exists."}, {"id": "readme_empty_context_short_circuit", "label": "Empty-context short-circuit (never calls Claude)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_secret_redaction", "label": "Secret redaction and streaming redaction", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrow high-precision patterns only, since a generic long-number pattern would false-positive on medical record IDs and phone numbers. Streaming holds back the newest 80 characters so a secret split across chunks is never on screen."}, {"id": "readme_source_attribution", "label": "Source attribution via sources_used structured output", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain text-instruction version was tried first and proved unreliable (the model dropped it on longer answers), so sources_used is a schema field validated against what was retrieved."}, {"id": "readme_offline_mode", "label": "Offline mode (RAG_LLM=off, quoted passages, -6 cutoff)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rate_limiting", "label": "Rate limiting (30 questions/hour per session, in-memory)", "file_type": "concept", "source_file": "README.md", "source_location": "Guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_event_logging", "label": "JSON event logging (logs/events.jsonl)", "file_type": "concept", "source_file": "README.md", "source_location": "Logging", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source paths are logged, never chunk text, because the log file is not access-controlled. cost_usd is null (never silently zero) when a model is absent from PRICING. Token counts include the query-rewrite call."}, {"id": "readme_evals", "label": "Golden-set evals (retrieval-only and --live with LLM judge)", "file_type": "concept", "source_file": "README.md", "source_location": "Evals", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live eval runs with the answer cache off so a cached answer can't hide a regression; agent cases are checked on outcomes, never on the order of steps."}, {"id": "readme_tests_and_evals_rationale", "label": "Why both tests and evals", "file_type": "rationale", "source_file": "README.md", "source_location": "Evals", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hybrid retriever is deliberately redundant: when BM25 degrades, vector search still surfaces the right chunk. A deliberately broken _tokenize() passed the full retrieval eval while tests/test_units.py caught it. Evals cover the pipeline end to end; unit tests guard components the pipeline can mask."}, {"id": "readme_four_modes", "label": "Four modes (orders, agent, content, find a file)", "file_type": "concept", "source_file": "README.md", "source_location": "Four modes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ask_about_orders", "label": "Ask about orders mode (NL to SQL with guard)", "file_type": "concept", "source_file": "README.md", "source_location": "Four modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude writes the SQL; search/orders.py runs it only if it is a single SELECT over the asker's role views, read-only, LIMIT 50, 2s timeout."}, {"id": "readme_ask_the_agent", "label": "Ask the agent mode (bounded tool loop, five tools)", "file_type": "concept", "source_file": "README.md", "source_location": "Four modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tools: search_docs, query_orders, find_file, ask_user, final_answer. Same guards inside the tools; role and access check bound in code, no tool takes identity as an argument. Bounded by RAG_AGENT_MAX_STEPS (6), a token budget and a deadline. Ungrounded answers are replaced and uncited files dropped. Opt-in because it makes several model calls per question."}, {"id": "readme_find_a_file", "label": "Find a file mode (SQLite FTS5 over names and paths)", "file_type": "concept", "source_file": "README.md", "source_location": "Four modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Costs nothing per query and covers files whose contents are never indexed (images, drawings, archives), which on a disorganized share is most of them."}], "edges": [{"source": "readme_rag_assistant", "target": "readme_ingest_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "readme_query_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "readme_guardrails", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Guardrails", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "readme_event_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Logging", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "readme_evals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Evals", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "readme_four_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Four modes", "weight": 1.0}, {"source": "readme_rag_assistant", "target": "demo_readme_in_browser_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L5", "weight": 1.0}, {"source": "readme_query_pipeline", "target": "rag_answer_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Architecture", "weight": 1.0}, {"source": "readme_single_entry_point", "target": "rag_answer_question", "relation": "rationale_for", "confidence": "